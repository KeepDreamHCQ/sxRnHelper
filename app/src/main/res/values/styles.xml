<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TextAppearance.Sx2libra.PaperTitle" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">kern</item>
    </style>

    <style name="TextAppearance.Sx2libra.PaperSubtitle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Sx2libra.PaperEyebrow" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/paper_orange_dark</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Sx2libra.PaperCardTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Sx2libra.PaperStatus" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Sx2libra.PaperAction" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Sx2libra.PaperSection" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Sx2libra.PaperEventTitle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Sx2libra.PaperMeta" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Widget.Sx2libra.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/icon_primary</item>
        <item name="android:padding">@dimen/libra_icon_button_padding</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.Sx2libra.MaterialAlertDialog" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/libra_radius_dialog</item>
    </style>

    <style name="Widget.Sx2libra.DialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/libra_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">64dp</item>
    </style>

    <style name="ThemeOverlay.Sx2libra.MaterialAlertDialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/libra_primary</item>
        <item name="colorSecondary">@color/libra_secondary</item>
        <item name="colorSurface">@color/dialog_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorAccent">@color/libra_primary</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Sx2libra.MaterialAlertDialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Sx2libra.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Sx2libra.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.Sx2libra.DialogButton</item>
    </style>

</resources>
