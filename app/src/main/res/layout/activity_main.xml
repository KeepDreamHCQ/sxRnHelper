<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_background"
    android:clipChildren="false">

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="top|start"
        android:alpha="0.92"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/bg_paper_corner"
        android:tint="@color/paper_pink" />

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="top|end"
        android:alpha="0.92"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:rotation="90"
        android:src="@drawable/bg_paper_corner"
        android:tint="@color/paper_mustard" />

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="bottom|start"
        android:alpha="0.92"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:rotation="270"
        android:src="@drawable/bg_paper_corner"
        android:tint="@color/paper_teal" />

    <ImageView
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="bottom|end"
        android:alpha="0.92"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:rotation="180"
        android:src="@drawable/bg_paper_corner"
        android:tint="@color/paper_lilac" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/calendar_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="116dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingEnd="112dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/calendar_page_title"
                        android:textAppearance="@style/TextAppearance.Sx2libra.PaperTitle" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/calendar_page_subtitle"
                        android:textAppearance="@style/TextAppearance.Sx2libra.PaperSubtitle" />

                </LinearLayout>

                <ImageView
                    android:layout_width="112dp"
                    android:layout_height="120dp"
                    android:layout_gravity="bottom|end"
                    android:contentDescription="@string/calendar_mascot_content_description"
                    android:scaleType="fitCenter"
                    android:src="@drawable/origami_cat" />

            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/paper_card_warm"
                app:cardCornerRadius="28dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/paper_border"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="232dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="22dp"
                        android:paddingTop="22dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="22dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge"
                            android:includeFontPadding="false"
                            android:paddingStart="12dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="6dp"
                            android:text="@string/calendar_monitor_badge"
                            android:textAppearance="@style/TextAppearance.Sx2libra.PaperEyebrow" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:text="@string/calendar_monitor_headline"
                            android:textAppearance="@style/TextAppearance.Sx2libra.PaperCardTitle" />

                        <TextView
                            android:id="@+id/calendar_monitor_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:textAppearance="@style/TextAppearance.Sx2libra.PaperStatus" />

                        <com.google.android.material.checkbox.MaterialCheckBox
                            android:id="@+id/calendar_monitor_checkbox"
                            android:layout_width="wrap_content"
                            android:layout_height="56dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_monitor_toggle"
                            android:buttonTint="@color/on_primary"
                            android:gravity="center_vertical"
                            android:minWidth="176dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="18dp"
                            android:text="@string/calendar_monitor_checkbox"
                            android:textAppearance="@style/TextAppearance.Sx2libra.PaperAction"
                            android:textColor="@color/on_primary" />

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:text="@string/calendar_events_title"
                    android:textAppearance="@style/TextAppearance.Sx2libra.PaperSection" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/calendar_events_hint"
                    android:textAppearance="@style/TextAppearance.Sx2libra.PaperEyebrow" />

            </LinearLayout>

            <TextView
                android:id="@+id/calendar_events_empty"
                android:layout_width="match_parent"
                android:layout_height="184dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_empty_state"
                android:drawableTop="@drawable/ic_calendar_outline"
                android:drawableTint="@color/paper_orange"
                android:drawablePadding="12dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:padding="24dp"
                android:text="@string/calendar_events_empty"
                android:textAppearance="@style/TextAppearance.Sx2libra.PaperStatus" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/calendar_events_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingBottom="8dp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</FrameLayout>
